[init]
	defaultBranch = main
[commit]
	template = ~/.git_commit_template
[include]
	path = ~/.config/git/config.local
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
[rerere]
	enabled = true
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[rebase]
	autosquash = true
	updateRefs = true
