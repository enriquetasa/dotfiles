# Sourced by EVERY zsh (scripts included), so keep this file cheap:
# plain environment variables only. PATH construction, Homebrew, and
# anything that shells out lives in zshprofile (login shells).

# Deduplicate PATH entries automatically (e.g. nested login shells)
typeset -U path fpath

export LANG="en_US.UTF-8"

# Homebrew: Stop the "Checking for updates" delay every time you run brew
export HOMEBREW_NO_AUTO_UPDATE=1
# Homebrew: Opt-out of analytics
export HOMEBREW_NO_ANALYTICS=1

# Python: Prevent Python from writing .pyc files (cleaner folders)
export PYTHONDONTWRITEBYTECODE=1

### --- COLORS & THEMES --- ###

# Enable colors in 'ls' and other system tools
export CLICOLOR=1
export LSCOLORS="Gxfxcxdxbxegedabagacad"

# Colorize 'grep' output
export GREP_COLORS="mt=01;31"
