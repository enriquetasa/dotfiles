### --- SHELL SESSION SECURITY --- ###

# Set default file creation permissions (User: read/write/execute, Group/World: read/execute)
umask 022

# Limit core dumps for better security/performance
limit core 0

### --- COMPILER & BUILD FLAGS--- ###

# Help compilers (C/C++, Rust, Go) find Homebrew-installed headers and libraries.
# HOMEBREW_PREFIX is set by zshenv on Macs with Homebrew; Linux needs none of this.
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
    export LDFLAGS="-L$HOMEBREW_PREFIX/lib"
    export CPPFLAGS="-I$HOMEBREW_PREFIX/include"
    export PKG_CONFIG_PATH="$HOMEBREW_PREFIX/opt/readline/lib/pkgconfig"
fi

### --- SSH & KEY MANAGEMENT --- ###

# Start one SSH agent and reuse it across logins, so you enter your passphrase once
# rather than on every git pull/push. Skipped when something already provides an
# agent (macOS launchd, a desktop keyring, SSH agent forwarding).
if [[ -z "${SSH_AUTH_SOCK:-}" && -d "$HOME/.ssh" ]]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
  ssh-add -l >/dev/null 2>&1
  if (( $? == 2 )); then  # 2 = no agent listening on the socket
    rm -f "$SSH_AUTH_SOCK"
    eval "$(ssh-agent -s -a "$SSH_AUTH_SOCK")" >/dev/null
  fi
  ssh-add -l >/dev/null 2>&1 || ssh-add -q 2>/dev/null  # load default keys if none are loaded
fi

### --- TMUX AUTO-START --- ###
# 1. Check if TMUX is installed
# 2. Check if we are NOT already inside a TMUX session ($TMUX is empty)
# 3. Check if stdin and stdout are a real terminal (not only an interactive shell)
if command -v tmux &> /dev/null && [ -z "$TMUX" ] && [ -t 0 ] && [ -t 1 ]; then
    # Attach to a session named "main" if it exists, otherwise create it
    exec tmux new-session -A -s main
fi

