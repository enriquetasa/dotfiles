# history
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
HISTORY_IGNORE="(ls|cd|pwd|exit|clear|history|fg|bg|jobs)"
setopt EXTENDED_HISTORY          # write the history file in the ":start:elapsed;command" format.
setopt HIST_REDUCE_BLANKS        # remove superfluous blanks before recording entry.
setopt SHARE_HISTORY             # share history between all sessions.
setopt HIST_IGNORE_ALL_DUPS      # delete old recorded entry if new entry is a duplicate.
setopt COMPLETE_ALIASES

# Oh My Zsh (optional until first install)
plugins=(
  git
  python
  colored-man-pages
  pip
  history
)
command -v direnv >/dev/null 2>&1 && plugins+=(direnv)
command -v thefuck >/dev/null 2>&1 && plugins+=(thefuck)

ZSH_THEME="clean"
COMPLETION_WAITING_DOTS="true"
[[ -f "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh" ]] && source "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh"

# ls: GNU uses --color; BSD/macOS uses -G (--version distinguishes GNU)
if command ls --version >/dev/null 2>&1; then
  alias ll="command ls -alh --color=auto"
elif command ls -G -d . >/dev/null 2>&1; then
  alias ll="command ls -alhG"
else
  alias ll="command ls -alh"
fi

if command grep --color=auto -q . /dev/null 2>&1; then
  alias grep="grep --color=auto"
fi

_dotfiles_editor() {
  if command -v nvim >/dev/null 2>&1; then
    command nvim "$@"
  elif command -v vim >/dev/null 2>&1; then
    command vim "$@"
  else
    command vi "$@"
  fi
}

zshrc() { _dotfiles_editor ~/.zshrc; }
vimrc() { _dotfiles_editor "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/init.vim"; }

if command -v nvim >/dev/null 2>&1; then
  alias vi="nvim"
  alias vim="nvim"
elif command -v vim >/dev/null 2>&1; then
  alias vi="vim"
fi

alias venv="echo 'layout python3' > .envrc && direnv allow"

# Editor (use whatever nvim is on PATH)
if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="vim"
  export VISUAL="vim"
fi

# VS Code: PATH shim when present; else macOS app bundle
if ! command -v code >/dev/null 2>&1; then
  if [[ "${OSTYPE}" == darwin* ]] && [[ -d "/Applications/Visual Studio Code.app" ]]; then
    alias code='open -a "Visual Studio Code"'
  fi
fi

# Python/pip on PATH; override with PYTHON_GLOBAL_OVERRIDE / PIP_GLOBAL_OVERRIDE
if [[ -n "${PYTHON_GLOBAL_OVERRIDE:-}" ]] && [[ -x "${PYTHON_GLOBAL_OVERRIDE}" ]]; then
  export PYTHON_GLOBAL="${PYTHON_GLOBAL_OVERRIDE}"
elif [[ -z "${PYTHON_GLOBAL:-}" ]] || [[ ! -x "${PYTHON_GLOBAL}" ]]; then
  command -v python3 >/dev/null 2>&1 && export PYTHON_GLOBAL="$(command -v python3)"
fi

if [[ -n "${PIP_GLOBAL_OVERRIDE:-}" ]] && [[ -x "${PIP_GLOBAL_OVERRIDE}" ]]; then
  export PIP_GLOBAL="${PIP_GLOBAL_OVERRIDE}"
elif [[ -z "${PIP_GLOBAL:-}" ]] || [[ ! -x "${PIP_GLOBAL}" ]]; then
  command -v pip3 >/dev/null 2>&1 && export PIP_GLOBAL="$(command -v pip3)"
fi

# rbenv (Ruby version management) when present
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - zsh)"
fi

# Git repo-archaeology helpers
alias what_changed="git log --format=format: --name-only --since='1 year ago' | sort | uniq -c | sort -nr | head -20"
alias who_built="git shortlog -sn --no-merges"
alias where_bugs="git log -i -E --grep='fix|bug|broken' --name-only --format='' | sort | uniq -c | sort -nr | head -20"
alias commit_count="git log --format='%ad' --date=format:'%Y-%m' | sort | uniq -c"
alias firefighting="git log --oneline --since='1 year ago' | grep -iE 'revert|hotfix|emergency|rollback|incident'"

# Machine-local overrides (PATHs, work config, terminal integrations) — not tracked in the repo
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
