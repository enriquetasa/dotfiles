# history
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
HISTORY_IGNORE="(ls|cd|pwd|exit|clear|history|fg|bg|jobs)"
setopt EXTENDED_HISTORY          # write the history file in the ":start:elapsed;command" format.
setopt HIST_REDUCE_BLANKS        # remove superfluous blanks before recording entry.
setopt SHARE_HISTORY             # share history between all sessions.
setopt HIST_FIND_NO_DUPS         # keep every run in the file (so usage can be counted), but show each command once when searching.
# No COMPLETE_ALIASES: aliases expand before completion, so Oh My Zsh git aliases
# (gco, gsw, grbi...) complete branch names like the git command they stand for.

# Oh My Zsh (optional until first install)
plugins=(
  git
  python
  colored-man-pages
  pip
  history
)
command -v direnv >/dev/null 2>&1 && plugins+=(direnv)
command -v thefuck >/dev/null 2>&1 && plugins+=(thefuck)

ZSH_THEME="clean"
COMPLETION_WAITING_DOTS="true"
[[ -f "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh" ]] && source "${ZSH:-$HOME/.oh-my-zsh}/oh-my-zsh.sh"

# ls: GNU uses --color; BSD/macOS uses -G (--version distinguishes GNU)
if command ls --version >/dev/null 2>&1; then
  alias ll="command ls -alh --color=auto"
elif command ls -G -d . >/dev/null 2>&1; then
  alias ll="command ls -alhG"
else
  alias ll="command ls -alh"
fi

if command grep --color=auto -q . /dev/null 2>&1; then
  alias grep="grep --color=auto"
fi

_dotfiles_editor() {
  if command -v nvim >/dev/null 2>&1; then
    command nvim "$@"
  elif command -v vim >/dev/null 2>&1; then
    command vim "$@"
  else
    command vi "$@"
  fi
}

zshrc() { _dotfiles_editor ~/.zshrc; }
# Neovim config is LazyVim (init.lua); fall back to init.vim for older setups.
# Opens from the config dir so file pickers (<leader><space>) search the config.
vimrc() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/nvim" init="init.lua"
  [[ -f "$dir/$init" ]] || init="init.vim"
  ( cd "$dir" && _dotfiles_editor "$init" )
}

if command -v nvim >/dev/null 2>&1; then
  alias vi="nvim"
  alias vim="nvim"
elif command -v vim >/dev/null 2>&1; then
  alias vi="vim"
fi

# Add `layout python3` to .envrc (appending, never overwriting) and allow it
alias venv="grep -qs 'layout python' .envrc || echo 'layout python3' >> .envrc; direnv allow"

# Editor (use whatever nvim is on PATH)
if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="vim"
  export VISUAL="vim"
fi

# VS Code: PATH shim when present; else macOS app bundle
if ! command -v code >/dev/null 2>&1; then
  if [[ "${OSTYPE}" == darwin* ]] && [[ -d "/Applications/Visual Studio Code.app" ]]; then
    alias code='open -a "Visual Studio Code"'
  fi
fi

# Python/pip on PATH; override with PYTHON_GLOBAL_OVERRIDE / PIP_GLOBAL_OVERRIDE
if [[ -n "${PYTHON_GLOBAL_OVERRIDE:-}" ]] && [[ -x "${PYTHON_GLOBAL_OVERRIDE}" ]]; then
  export PYTHON_GLOBAL="${PYTHON_GLOBAL_OVERRIDE}"
elif [[ -z "${PYTHON_GLOBAL:-}" ]] || [[ ! -x "${PYTHON_GLOBAL}" ]]; then
  command -v python3 >/dev/null 2>&1 && export PYTHON_GLOBAL="$(command -v python3)"
fi

if [[ -n "${PIP_GLOBAL_OVERRIDE:-}" ]] && [[ -x "${PIP_GLOBAL_OVERRIDE}" ]]; then
  export PIP_GLOBAL="${PIP_GLOBAL_OVERRIDE}"
elif [[ -z "${PIP_GLOBAL:-}" ]] || [[ ! -x "${PIP_GLOBAL}" ]]; then
  command -v pip3 >/dev/null 2>&1 && export PIP_GLOBAL="$(command -v pip3)"
fi

# rbenv (Ruby version management) when present
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - zsh)"
fi

# Navigation
cdpath=(~/CODE)                                   # `cd persephone` (or just `persephone`, auto_cd is on) from anywhere
dot() { cd "${${:-$HOME/.zshrc}:A:h:h}"; }        # this dotfiles repo, wherever it is cloned (via the ~/.zshrc symlink)
alias reload='exec zsh'
setopt CORRECT                                    # offer to fix mistyped commands ("cladue" -> "claude")

# clone repo | org/repo | full URL | several at once; cd's into it when given one.
# Bare repo names use $GH_DEFAULT_ORG (default: oees).
clone() {
  local spec url
  for spec in "$@"; do
    case $spec in
      *:*) url=$spec ;;
      */*) url="git@github.com:${spec%.git}.git" ;;
      *)   url="git@github.com:${GH_DEFAULT_ORG:-oees}/${spec%.git}.git" ;;
    esac
    git clone "$url" || return
  done
  (( $# == 1 )) && cd "${${1:t}%.git}"
}

# Move the newest file or folder in ~/Downloads here: `grab`, or `grab new-name`
grab() {
  local f=(~/Downloads/*(om[1]N))
  [[ -n $f ]] || { echo "~/Downloads is empty"; return 1; }
  mv -i "$f" "./${1:-${f:t}}"
}

# Python
alias lint='ruff check --fix . && ruff format .'
alias va='source .venv/bin/activate'

# Keys and secrets
randhex()   { openssl rand -hex "${1:-16}"; }             # randhex [bytes]
fernetkey() { openssl rand -base64 32 | tr '+/' '-_'; }   # url-safe 32-byte key, the cryptography.Fernet format
if command -v pbcopy >/dev/null 2>&1; then
  pubkey() { pbcopy < ~/.ssh/${1:-github}.pub && echo "copied ${1:-github}.pub"; }
fi

# tmux: `ta` attaches to the last session, `ta name` to a specific one
ta() { if (( $# )); then tmux attach -t "$1"; else tmux attach; fi; }
alias tl='tmux ls'
alias tn='tmux new -s'

# Tools
alias dstart='colima start --cpu 4 --memory 8'
alias dstop='colima stop'
alias sb='npx supabase'
alias bup='brew update && brew upgrade && brew cleanup'
alias clc='claude --continue'
alias clr='claude --resume'
alias myip='curl -4 -s ifconfig.me; echo'

# Git repo-archaeology helpers
alias what_changed="git log --format=format: --name-only --since='1 year ago' | sort | uniq -c | sort -nr | head -20"
alias who_built="git shortlog -sn --no-merges"
alias where_bugs="git log -i -E --grep='fix|bug|broken' --name-only --format='' | sort | uniq -c | sort -nr | head -20"
alias commit_count="git log --format='%ad' --date=format:'%Y-%m' | sort | uniq -c"
alias firefighting="git log --oneline --since='1 year ago' | grep -iE 'revert|hotfix|emergency|rollback|incident'"

# Disk: check free space and clear out my own stale /tmp files
alias dfh='df -h / /tmp "$HOME"'
tmpclean() {
  find /tmp -xdev -user "$USER" -mtime +1 -print 2>/dev/null
  read -q "?Delete the above? [y/N] " && echo && find /tmp -xdev -user "$USER" -mtime +1 -delete 2>/dev/null
}

# Machine-local overrides (PATHs, work config, terminal integrations) — not tracked in the repo
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
